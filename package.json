{
  "name": "@tetherto/wdk-asset-registry",
  "version": "1.0.0-beta.2",
  "description": "The type system and interfaces for standardized asset identification across all WDK modules.",
  "keywords": [
    "wdk",
    "asset",
    "registry"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/tetherto/wdk-asset-registry.git"
  },
  "type": "module",
  "main": "index.js",
  "types": "./types",
  "scripts": {
    "build:types": "tsc",
    "build:assets": "node scripts/build-assets.js",
    "test": "npm run build:assets && cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "npm run build:assets && cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "standard",
    "lint:fix": "standard --fix"
  },
  "dependencies": {
    "fast-equals": "6.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "30.3.0",
    "standard": "17.1.2",
    "typescript": "6.0.2"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    },
    "./assets/*": {
      "default": "./dist/*.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "tests/**/*.js"
    ]
  }
}
